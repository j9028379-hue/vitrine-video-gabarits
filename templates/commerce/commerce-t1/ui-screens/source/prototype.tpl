<!doctype html><html lang="fr"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Vitrine Vidéo — Studio de capture</title><style>
*{box-sizing:border-box}body{margin:0;background:#f5f3eb;color:#173d39;font:16px/1.45 system-ui,sans-serif}button{font:inherit;cursor:pointer}button:focus-visible{outline:3px solid #c04d24;outline-offset:2px}.top{border-bottom:1px solid #c7cdc1;padding:16px 4vw;display:flex;justify-content:space-between;align-items:center}.brand{font-weight:850;letter-spacing:-.05em;font-size:21px}.brand i{background:#1e524c;color:#d9ffa3;padding:2px 8px;border-radius:9px;margin-right:8px}.label{font:700 11px/1.4 ui-monospace,monospace;letter-spacing:.12em;text-transform:uppercase}.layout{display:grid;grid-template-columns:minmax(280px,400px) minmax(340px,430px);justify-content:center;gap:clamp(30px,6vw,100px);align-items:start;padding:28px 20px}.intro h1{font-size:clamp(38px,5vw,64px);line-height:.98;letter-spacing:-.065em;margin:16px 0}.intro>p{max-width:38ch}.index{margin-top:22px}.row{display:grid;grid-template-columns:1fr repeat(3,40px);gap:5px;align-items:center;margin:8px 0}.row strong{font-size:15px}.row button{border:1px solid #9faea1;background:none;border-radius:7px;color:#174039;padding:6px}.row button.on{background:#174039;color:white}.explain{font-size:13px;color:#49635c}.phone{width:100%;max-width:430px;background:#fffcf5;border:1px solid #9daea4;border-radius:23px;overflow:hidden;box-shadow:0 12px 35px #1f42341a;position:relative}.inside{padding:17px 19px}.ph{display:flex;align-items:center;justify-content:space-between;font-size:13px;font-weight:750}.progress{display:flex;gap:4px;margin:10px 0 15px}.progress b{height:4px;flex:1;background:#d6ddd2;border-radius:5px}.progress b.done{background:#32746a}.phone h2{font-size:28px;line-height:1.05;letter-spacing:-.045em;margin:9px 0}.hero{height:133px;background-size:cover;background-position:50% 51%;border-radius:10px;margin:12px 0;position:relative}.hero:after{content:'Exemple de cadrage';position:absolute;bottom:7px;left:8px;color:white;background:#193932db;font-size:12px;padding:2px 7px;border-radius:4px}.info{margin:8px 0;font-size:15px;line-height:1.35}.info b{color:#137060}.voice{padding:10px 12px;background:#eaf1df;border-radius:9px;font-size:14px;margin:12px 0}.btn{border:0;border-radius:9px;padding:13px 10px;min-height:44px;width:100%;font-size:14px;font-weight:800;background:#184b43;color:white}.btn.alt{background:transparent;color:#16463d;border:1px solid #83978c}.actions{display:flex;gap:6px}.actions button:first-child{width:33%}.media{position:relative;height:clamp(480px,75vh,650px);background:#172725}.media video,.replay video{width:100%;height:100%;display:block;object-fit:cover}.tags{position:absolute;top:15px;left:14px;right:14px;display:flex;justify-content:space-between}.badge{font:700 14px ui-monospace,monospace;border-radius:20px;color:white;background:#122822db;padding:7px 10px}.rec{color:#ff765e}.timer{position:absolute;bottom:24px;left:20px;right:20px;color:white;text-shadow:0 1px 5px #111;font-variant-numeric:tabular-nums;font-weight:750}.track{background:#0007;height:6px;margin-top:8px;border-radius:5px;overflow:hidden}.track div{background:#dfffad;height:100%}.count{position:absolute;inset:0;background:#0b1a16aa;color:white;display:grid;place-items:center;font-size:80px;font-weight:750}.replay{height:240px;background:#172725;border-radius:10px;overflow:hidden;margin-top:12px}.replay video{object-fit:contain}.sound{width:100%;margin:8px 0;background:#e4efdc;color:#1e4943;border:0;border-radius:8px;padding:11px;font-weight:700}.foot{font-size:13px;margin:12px 0}.note{margin:16px 0;border-top:1px solid #afbdaf;padding-top:12px;font-size:13px}.return{width:auto;padding:8px 12px}.screenid{color:#527569}.donebox{padding:30px}.phone p{margin:8px 0}.lab{color:#57685b}.phone button:disabled{opacity:.5}@media(max-width:740px){.layout{display:flex;flex-direction:column;padding:12px;align-items:center;gap:15px}.intro{display:contents}.intro h1,.intro>p,.intro>.label,.intro>.note{display:none}.index{order:2;width:100%;max-width:430px;margin:0}.phone{order:1}.top{padding:10px 14px}.top .label{font-size:9px}.inside{padding:15px}.media{height:550px}.hero{height:117px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style><header class="top"><div class="brand"><i>V</i>Vitrine Vidéo</div><span class="label">Commerce-T1 · Prototype</span></header><main class="layout"><aside class="intro"><span class="label">Studio de capture / 01</span><h1>Quatre prises.<br>Douze écrans.</h1><p>Parcours commerçant pour une publicité de <b>30 secondes</b>. Suis les boutons du téléphone ou ouvre un écran précis dans l’index.</p><div class="index"><span class="label">Index de revue</span><div id="nav"></div><p class="explain">A · Guide &nbsp; B · Enregistrement &nbsp; C · Vérification</p></div><div class="note">Simulation hors ligne : le téléphone utilise une illustration animée et sa piste sonore de démonstration. Ni ta caméra ni ton micro ne sont activés. Les transitions de la publicité ne recouvrent pas la prise de vue.</div></aside><section class="phone" id="phone" aria-label="Écran du commerçant"></section></main><script>
const G=__GUIDE__,M=__MEDIA__,U=G.ui,ph=document.querySelector('#phone');let n=0,k=0,loop=0,clock=0,token=0,takes=[null,null,null,null],serial=0;const fmt=s=>'00:'+String(s).padStart(2,'0');function onNav(){document.querySelector('#nav').innerHTML=G.scenes.map((s,i)=>`<div class="row"><strong>0${i+1} · ${s.title}</strong>${['A','B','C'].map((c,j)=>`<button aria-label="Scène ${i+1}, ${G.states[j]}" class="${n===i&&j===k?'on':''}" onclick="jump(${i},${j})">${c}</button>`).join('')}</div>`).join('')}
function clear(){clearInterval(loop);clearInterval(clock);token++;ph.querySelectorAll('video').forEach(v=>v.pause())}function jump(i,j){clear();n=i;k=j;if(j===2&&!takes[i])takes[i]={id:++serial,valid:false};draw()}function head(s){return `<div class="ph"><span>Scène ${s.id} sur 4</span><span class="screenid">${G.states[k]}</span></div><div class="progress">${G.scenes.map((_,i)=>`<b class="${i<=n?'done':''}"></b>`).join('')}</div>`}
function draw(){const s=G.scenes[n],m=M[n];onNav();if(k===0){ph.innerHTML=`<div class="inside">${head(s)}<div class="label lab">Prise ${s.capture} s · Film final ${s.kept} s</div><h2>${s.title}</h2><p>${s.instruction}</p><div class="hero" style="background-image:url('${m.guide}')"></div><div class="info"><b>À filmer ·</b> ${s.needed}</div><div class="info"><b>À éviter ·</b> ${s.avoid}</div><div class="voice">${U.voice}<br>Exemple : « ${s.sample} »</div><button class="btn" onclick="countdown(this)">${U.start}</button></div>`}
if(k===1){ph.innerHTML=`<div class="media"><video muted playsinline poster="${m.img}" src="${m.vid}"></video><div class="tags"><span class="badge"><span class="rec">●</span> ${U.record}</span><span class="badge">${U.mic}</span></div><div class="timer"><span id="tm">00:00 / ${fmt(s.capture)}</span><div class="track"><div id="bar" style="width:0%"></div></div></div></div>`;let v=ph.querySelector('video'),id=token;v.play().catch(()=>{});const t=performance.now();loop=setInterval(()=>{if(id!==token)return;const elapsed=(performance.now()-t)/1000;document.querySelector('#tm').textContent=fmt(Math.min(s.capture,Math.floor(elapsed)))+' / '+fmt(s.capture);document.querySelector('#bar').style.width=Math.min(100,elapsed/s.capture*100)+'%';if(elapsed>=s.capture){takes[n]={id:++serial,valid:false};jump(n,2)}},80)}
if(k===2){ph.innerHTML=`<div class="inside">${head(s)}<div class="label lab">${s.title} · Prise ${s.capture} s</div><h2>${U.verify}</h2><div class="replay"><video playsinline preload="metadata" poster="${m.img}" src="${m.vid}"></video></div><button class="sound" onclick="replay(this)">▷ ${U.play}</button><div class="foot">${U.confirm}</div><div class="actions"><button class="btn alt" onclick="redo()">${U.retry}</button><button class="btn" onclick="accept()">${n===3?U.finish:U.next}</button></div></div>`;ph.querySelector('video').onended=()=>{ph.querySelector('.sound').textContent='▷ '+U.play}}}
function countdown(b){b.disabled=true;let x=3;const cover=document.createElement('div');cover.className='count';cover.setAttribute('role','status');cover.textContent=x;ph.appendChild(cover);clock=setInterval(()=>{if(--x>0)cover.textContent=x;else jump(n,1)},1000)}
function replay(b){let v=ph.querySelector('video');if(v.paused){v.muted=false;if(v.ended)v.currentTime=0;v.play().then(()=>b.textContent='Ⅱ '+U.pause).catch(()=>b.textContent='Réessayer la lecture')}else{v.pause();b.textContent='▷ '+U.play}}function redo(){takes[n]=null;jump(n,0)}function accept(){takes[n].valid=true;if(n<3){jump(n+1,0);return}clear();k=-1;onNav();ph.innerHTML=`<div class="donebox"><div class="label">Sortie de la simulation</div><h2>Vers le montage</h2><p>${takes.every(t=>t&&t.valid)?U.end:'Aperçu de la destination après validation des quatre prises.'}</p><button class="btn" onclick="takes.fill(null);jump(0,0)">Revoir le parcours</button></div>`}jump(0,0);
</script></html>
