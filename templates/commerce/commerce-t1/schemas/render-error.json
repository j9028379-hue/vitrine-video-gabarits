{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template_id",
    "version",
    "job_id",
    "status",
    "code",
    "message"
  ],
  "properties": {
    "template_id": {
      "const": "COMMERCE-T1"
    },
    "version": {
      "const": "2.0.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "FAILED"
    },
    "code": {
      "enum": [
        "INVALID_JOB",
        "INVALID_CAPTURE",
        "UNSUPPORTED_MEDIA",
        "INVALID_SELECTION",
        "RENDER_FAILED"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    }
  }
}
