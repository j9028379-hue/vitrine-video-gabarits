{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template_id",
    "version",
    "job_id",
    "status",
    "mode",
    "output",
    "sha256",
    "bytes"
  ],
  "properties": {
    "template_id": {
      "const": "COMMERCE-T1"
    },
    "version": {
      "const": "2.0.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "COMPLETED"
    },
    "mode": {
      "enum": [
        "silent",
        "demo-approved",
        "merchant-music"
      ]
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0
    }
  }
}
